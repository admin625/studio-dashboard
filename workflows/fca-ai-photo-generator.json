      "parameters": {
        "jsCode": "const b = $input.first().json.body || $input.first().json;\nconst prompt = (b.prompt || '').toLowerCase();\nconst contentFocus = (b.content_focus || '').toLowerCase();\n\n// Smart routing: Flux2 Pro only for text overlay, product shots, or explicit request\nlet platform = b.platform || 'nano_banana_pro';\nif (!b.platform || b.platform === 'auto') {\n  const needsFlux = /text overlay|product shot|product photo|logo|watermark|typography|text on image/i.test(prompt + ' ' + contentFocus);\n  platform = needsFlux ? 'flux2_pro' : 'nano_banana_pro';\n}\n\n// Camera profile classification\nconst profiles = {\n  portrait: { lens: '85mm f/1.4', camera: 'Sony A7IV', lighting: 'Rembrandt lighting with fill card, catchlights in eyes', settings: 'ISO 200, 1/200s, f/1.4, shallow depth of field' },\n  action: { lens: '24-70mm f/2.8', camera: 'Canon R5', lighting: 'High-speed flash freeze, dramatic rim light', settings: 'ISO 800, 1/2000s, f/2.8, peak action frozen' },\n  studio: { lens: '35mm f/1.8', camera: 'Nikon Z8', lighting: 'Three-point studio setup, key + fill + hair light, clean backdrop', settings: 'ISO 100, 1/160s, f/5.6, even exposure' },\n  lifestyle: { lens: '50mm f/1.2', camera: 'Sony A7RV', lighting: 'Golden hour window light, warm ambient glow', settings: 'ISO 400, 1/125s, f/1.2, creamy bokeh background' },\n  food: { lens: '90mm f/2.8 macro', camera: 'Canon R6 II', lighting: 'Soft diffused overhead, white bounce below, no harsh shadows', settings: 'ISO 200, 1/80s, f/4, tight focus on hero dish' }\n};\n\nlet profileType = 'lifestyle';\nif (/portrait|headshot|instructor|trainer|coach|face|profile/i.test(prompt + ' ' + contentFocus)) profileType = 'portrait';\nelse if (/action|jumping|running|hiit|boxing|crossfit|burpee|exercise|workout|sweat|moving/i.test(prompt + ' ' + contentFocus)) profileType = 'action';\nelse if (/studio|interior|equipment|gym|facility|space|room|class setup/i.test(prompt + ' ' + contentFocus)) profileType = 'studio';\nelse if (/food|meal|nutrition|smoothie|protein|snack|recipe|bowl|prep/i.test(prompt + ' ' + contentFocus)) profileType = 'food';\n\nconst cam = profiles[profileType];\nconst cameraAppend = `\\n\\nPhotographed with ${cam.camera}, ${cam.lens} lens. ${cam.lighting}. Camera settings: ${cam.settings}.`;\n\nlet enhancedPrompt = b.prompt || 'Professional fitness instructor in modern gym';\nif (platform === 'nano_banana_pro') {\n  enhancedPrompt = enhancedPrompt + cameraAppend;\n}\n\nreturn [{ json: { ...b, platform, prompt: enhancedPrompt, camera_profile: profileType, camera_settings: cam, original_prompt: b.prompt || '' } }];"
      }
    },
