        "jsCode": "const parsed = $input.first().json;\nif (parsed.status !== 'ready' || !parsed.image_base64) {\n  return [{ json: { ...parsed, skip_upload: true } }];\n}\n\nconst studioId = $('Route Request').first().json.studio_id || 'unknown';\nconst ts = Date.now();\nconst filename = `ai-generated/${studioId}/${ts}.jpg`;\nconst publicUrl = `https://kidgcrqxrfcbsaeguwop.supabase.co/storage/v1/object/public/studio-photos/${filename}`;\n\nconst buffer = Buffer.from(parsed.image_base64, 'base64');\n\nreturn [{\n  json: {\n    status: parsed.status,\n    model: parsed.model,\n    text_response: parsed.text_response || '',\n    filename,\n    publicUrl,\n    skip_upload: false\n  },\n  binary: {\n    data: await this.helpers.prepareBinaryData(buffer, `${ts}.jpg`, 'image/jpeg')\n  }\n}];"
      }
