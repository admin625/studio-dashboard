      "parameters": {
        "jsCode": "// Build Kling 3.0 prompt from studio brand profile + reel script\nconst body = $input.first().json;\nconst script = body.reel_script;\nconst studioName = body.studio_name || 'Fitness Studio';\nconst studioType = body.studio_type || 'general_fitness';\nconst brandVoice = body.brand_voice || '';\nconst instructorName = body.instructor_name || 'Instructor';\nconst mood = script?.mood || 'motivational';\n\nconst styleMap = {\n  yoga_pilates: 'serene yoga studio, natural light, wooden floors and plants, calm and grounded',\n  hiit_crossfit: 'high-energy gym, dramatic lighting, intense workout atmosphere',\n  dance_barre: 'elegant dance studio, mirrors, ballet barre, graceful movement',\n  martial_arts: 'martial arts dojo, disciplined atmosphere, focused training',\n  indoor_cycling: 'cycling studio, dynamic lighting, spinning bikes, high energy',\n  general_fitness: 'modern fitness studio, clean and bright, welcoming atmosphere'\n};\nconst style = styleMap[studioType] || styleMap.general_fitness;\n\nconst moodMap = {\n  high_energy: 'dynamic, fast-paced, adrenaline',\n  motivational: 'inspiring, empowering, uplifting',\n  chill: 'calm, relaxed, meditative',\n  educational: 'focused, instructional, clear'\n};\nconst energy = moodMap[mood] || moodMap.motivational;\n\nconst sceneDescriptions = (script?.scenes || []).slice(0, 3).map(s => s.image_description || s.text || '').filter(Boolean);\nconst sceneContext = sceneDescriptions.length > 0 ? sceneDescriptions.join(', ') : 'fitness class in action';\n\nconst prompt = `Cinematic vertical video of ${sceneContext} in a ${style}, ${energy} energy, professional fitness content for ${studioName}, shot on Sony A7IV, shallow depth of field, warm color grading, vertical format for Instagram Reels`;\n\nconst apiKey = $vars.MODELSLAB_API_KEY;\nif (!apiKey) throw new Error('MODELSLAB_API_KEY not configured');\n\nreturn [{ json: {\n  delivery_id: body.delivery_id,\n  api_payload: {\n    key: apiKey,\n    model_id: 'kling-v3-t2v',\n    prompt: prompt,\n    negative_prompt: 'blurry, low quality, watermark, text overlay, distorted faces, amateur, shaky',\n    height: 1920,\n    width: 1080,\n    num_frames: 85,\n    output_format: 'mp4'\n  }\n} }];"
      }
    },
