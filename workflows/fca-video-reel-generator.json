        -1760,
        -100
      ],
      "parameters": {
        "jsCode": "// Look up studio branding + premium gate (uses this.helpers.httpRequest for sandbox compat)\nconst body = $input.first().json.body || $input.first().json;\nconst deliveryId = body.delivery_id;\nconst supabaseUrl = 'https://kidgcrqxrfcbsaeguwop.supabase.co';\nconst key = $vars.FCA_SUPABASE_SERVICE_KEY;\n\nlet brand = { brand_color: null, brand_color_secondary: null, brand_font: null, studio_name: null, logo_url: null, premium_video_enabled: false };\n\nif (deliveryId) {\n  const deliveries = await this.helpers.httpRequest({\n    method: 'GET',\n    url: supabaseUrl + '/rest/v1/content_deliveries?id=eq.' + deliveryId + '&select=studio_id',\n    headers: { apikey: key, Authorization: 'Bearer ' + key },\n    json: true\n  });\n  if (Array.isArray(deliveries) && deliveries.length > 0 && deliveries[0].studio_id) {\n    const studioId = deliveries[0].studio_id;\n    const studios = await this.helpers.httpRequest({\n      method: 'GET',\n      url: supabaseUrl + '/rest/v1/studio_accounts?id=eq.' + studioId + '&select=studio_name,brand_color,brand_color_secondary,brand_font,brand_voice,logo_url,studio_type,premium_video_enabled',\n      headers: { apikey: key, Authorization: 'Bearer ' + key },\n      json: true\n    });\n    if (Array.isArray(studios) && studios.length > 0) brand = studios[0];\n  }\n}\n\nif (!brand.premium_video_enabled) {\n  throw new Error('Premium feature — upgrade to access video generation');\n}\n\nconst primaryColor = brand.brand_color || body.brand_color || '#1a1a1a';\nconst secondaryColor = brand.brand_color_secondary || '#ffffff';\nconst studioName = brand.studio_name || body.studio_name || 'Fitness Studio';\nconst logoUrl = brand.logo_url || body.logo_url || '';\nconst brandFont = brand.brand_font || body.brand_font || 'Montserrat';\nconst brandVoice = brand.brand_voice || '';\nconst studioType = brand.studio_type || 'general_fitness';\n\nreturn [{ json: { ...body, brand_color: primaryColor, brand_color_secondary: secondaryColor, studio_name: studioName, logo_url: logoUrl, brand_font: brandFont, brand_voice: brandVoice, studio_type: studioType } }];"
      }
    },
    {
      "id": "6884dafe-320c-4dc5-8aae-edce7f3e84e5",
      "name": "Build Voiceover Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1536,
        -100
      ],
      "parameters": {
        "jsCode": "// Build voiceover script from reel scenes\nconst body = $json;\nconst script = body.reel_script;\nif (!script || !script.scenes) return [{ json: { ...body, voiceover_text: '' } }];\n\n// Concatenate scene text, skip the last CTA scene\nconst scenes = script.scenes.slice(0, -1);\nconst voText = scenes.map(s => s.text).filter(Boolean).join('. ') + '.';\n\nreturn [{ json: { ...body, voiceover_text: voText } }];"
      },
