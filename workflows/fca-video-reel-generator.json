      "parameters": {
        "jsCode": "// Check ModelsLab status\nconst r = $('Kling - Check Status').first().json;\nconst d = $('Extract Render ID').first().json.delivery_id;\nconst status = r.status || 'processing';\nif (status === 'error' || status === 'failed') {\n  return [{ json: { delivery_id: d, status: 'failed', error: r.message || r.messege || 'Unknown error' } }];\n}\n// Pass through output URL if succeeded\nconst outputUrl = (Array.isArray(r.output) && r.output.length > 0) ? r.output[0] : r.output || null;\nreturn [{ json: { delivery_id: d, status: status, video_url: outputUrl } }];"
      }
    },
