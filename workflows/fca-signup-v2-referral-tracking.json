      "name": "Check if Email Exists",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -144,
        -16
      ],
      "parameters": {
        "jsCode": "const webhookData = $input.item.json.body;\n\n// Query Supabase to check if email exists\nconst response = await this.helpers.httpRequest({\n  method: 'GET',\n  url: 'https://kidgcrqxrfcbsaeguwop.supabase.co/rest/v1/clients?email=eq.' + webhookData.email,\n  headers: {\n    'apikey': $vars.FCA_SUPABASE_SERVICE_KEY,\n    'Authorization': 'Bearer ' + $vars.FCA_SUPABASE_SERVICE_KEY\n  },\n  json: true\n});\n\nif (response.length > 0) {\n  // Email already exists\n  return [{\n    json: {\n      exists: true,\n      email: webhookData.email\n    }\n  }];\n} else {\n  // New email - pass through all webhook data\n  return [{\n    json: {\n      exists: false,\n      ...webhookData\n    }\n  }];\n}"
      }
    },
