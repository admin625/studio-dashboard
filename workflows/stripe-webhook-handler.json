    {
      "id": "handle-sub-updated-001",
      "name": "Handle Sub Updated",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        416,
        64
      ],
      "parameters": {
        "jsCode": "const sub = $json.body.data.object;\nconst customerId = sub.customer;\nconst status = sub.status;\nlet tier = 'basic';\nif (sub.items && sub.items.data && sub.items.data[0]) {\n  const price = sub.items.data[0].price;\n  if (price.metadata && price.metadata.plan_tier) {\n    tier = price.metadata.plan_tier;\n  } else if (price.unit_amount >= 14900) {\n    tier = 'pro';\n  }\n}\nreturn [{ json: { customer_id: customerId, subscription_status: status, subscription_tier: tier } }];"
      }
    },
