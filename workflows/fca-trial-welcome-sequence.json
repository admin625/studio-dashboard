    {
      "id": "bb2bfb7d-b6d6-4d92-a8f0-75f7f369dbff",
      "name": "Validate Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst body = input.body || input;\n\n// Validate required fields\nif (!body.email) {\n  return [{\n    json: {\n      error: true,\n      message: 'Email is required'\n    }\n  }];\n}\n\n// Clean and prepare data - map form fields to our fields\nreturn [{\n  json: {\n    email: body.email.toLowerCase().trim(),\n    first_name: body.name || '',\n    promo_code: body.referral_code || null,\n    source: body.how_heard || 'direct',\n    business_name: body.business_name || '',\n    location: body.location || '',\n    trial_start_date: new Date().toISOString(),\n    error: false\n  }\n}];"
      }
    },
    {
      "id": "8a8214c6-5fb1-46a4-b7fa-be75cec26ea1",
      "name": "Is Valid?",
      "type": "n8n-nodes-base.filter",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "no-error",
              "leftValue": "={{ $json.error }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
