    {
      "id": "7c9ca534-f236-4991-a1e7-0fb505add042",
      "name": "Personalize Welcome",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1104,
        0
      ],
      "parameters": {
        "jsCode": "const trial = $('Create Trial Record').first().json;\nconst templates = $input.all().map(i => i.json);\nconst template = templates[0];\n\nif (!template) {\n  // Fallback welcome email if template not found\n  return [{\n    json: {\n      trial_id: trial.id,\n      to: trial.email,\n      first_name: trial.first_name,\n      subject: 'Welcome to FCA — let\\'s get your first week of content ready',\n      body: `<p>Hey ${trial.first_name || 'there'}!</p>\n<p>Welcome to FCA. You've got 7 days to test everything out — no card required, no strings attached.</p>\n<p><a href=\"https://app.fiorsaoirse.com/dashboard\">Get started now →</a></p>\n<p>Questions? Just reply to this email.</p>\n<p>— Mac<br>Founder, FCA</p>`\n    }\n  }];\n}\n\nconst dashboardLink = 'https://app.fiorsaoirse.com/dashboard';\nconst loomLink = 'https://www.loom.com/share/YOUR_LOOM_ID';\n\n// Brand color defaults at welcome stage — studio_accounts record does not exist yet.\n// Falls back to FCA default. Email scaffold still renders the top-border accent correctly.\nconst brandColor = '#6366F1';\nconst unsubscribeUrl = 'mailto:admin@fiorsaoirse.com?subject=Unsubscribe';\n\nlet subject = template.subject || 'Welcome to FCA';\nlet body = template.body_html || template.body_text || '';\n\n// Replace placeholders\nconst replacements = {\n  '{{first_name}}': trial.first_name || 'there',\n  '{{brand_color}}': brandColor,\n  '{{unsubscribe_url}}': unsubscribeUrl,\n  '[DASHBOARD_LINK]': dashboardLink,\n  '[LOOM_LINK]': loomLink\n};\n\nfor (const [placeholder, value] of Object.entries(replacements)) {\n  body = body.split(placeholder).join(value);\n  subject = subject.split(placeholder).join(value);\n}\n\nreturn [{\n  json: {\n    trial_id: trial.id,\n    to: trial.email,\n    first_name: trial.first_name,\n    subject: subject,\n    body: body,\n    brand_color: brandColor,\n    source: trial.source,\n    promo_code: trial.promo_code\n  }\n}];"
      }
    },
